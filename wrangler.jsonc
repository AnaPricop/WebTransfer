{
  // Frontend-ul WebBeam: fisierele statice din dist/ (rezultatul lui `npm run build`).
  // Numele trebuie sa fie identic cu "Project name" din Cloudflare.
  "name": "webbeam",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // linkurile /room/<id> nu sunt fisiere: se serveste index.html si React alege pagina
    "not_found_handling": "single-page-application"
  }
}
